  {
    "id": "rule1",
    "title": "规则 1：词尾 e 不发音，前面元音读本身音",
    "summary": "单词以「元音+辅音+e」结尾时，末尾 e 不发音，前面的元音读字母本身的音。",
    "detail": "看到「元音+辅音+e」结尾的词，末尾的 e 直接忽略，前面那个元音读它字母本来的音，比如 name 里的 a 就读字母名 /eɪ/。",
    "examples": [
      { "word": "name", "kk": "/neɪm/", "note": "a 读 /eɪ/，词尾 e 不发音" },
      { "word": "ride", "kk": "/raɪd/", "note": "i 读 /aɪ/" },
      { "word": "came", "kk": "/keɪm/", "note": "a 读 /eɪ/" },
      { "word": "home", "kk": "/hoʊm/", "note": "o 读 /oʊ/" }
    ],
    "mouthTips": [],
    "commonMistakes": []
