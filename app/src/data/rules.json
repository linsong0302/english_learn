    "id": "rule3",
    "title": "规则 3：oo 相连的发音",
    "summary": "多数情况读短音 /ʊ/（good、book）；少数情况读长音 /u/（room、food）。",
    "detail": "遇到 oo 先按多数情况读短音 /ʊ/，room / food / moon 这类常用词单独记住长音 /u/ 就行。",
    "examples": [
      { "word": "good", "kk": "/gʊd/", "note": "多数：短音 /ʊ/" },
      { "word": "book", "kk": "/bʊk/", "note": "多数：短音 /ʊ/" },
      { "word": "look", "kk": "/lʊk/", "note": "多数：短音 /ʊ/" },
      { "word": "foot", "kk": "/fʊt/", "note": "多数：短音 /ʊ/" },
      { "word": "room", "kk": "/rum/", "note": "少数：长音 /u/" },
      { "word": "food", "kk": "/fud/", "note": "少数：长音 /u/" }
