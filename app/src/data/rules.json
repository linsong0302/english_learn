  {
    "id": "rule2",
    "title": "规则 2：元音 + r 的发音",
    "summary": "a/e/i/o/u + r：第一次出现（重音节）读长音 /ɝ/；第二次出现或词尾（非重音）读短音 /ɚ/。",
    "detail": "看元音+r 在单词里的位置：第一次出现就卷舌拖长读 /ɝ/；第二次出现或在词尾就轻轻卷舌读 /ɚ/。比如 worker：work 里的 or 读 /ɝ/，词尾 er 读 /ɚ/。",
    "examples": [
      { "word": "work", "kk": "/wɝk/", "note": "重音节，or 读 /ɝ/ 卷舌拖长" },
      { "word": "bird", "kk": "/bɝd/", "note": "ir 读 /ɝ/" },
      { "word": "her", "kk": "/hɝ/", "note": "er 读 /ɝ/" },
      { "word": "worker", "kk": "/ˈwɝkɚ/", "note": "词尾 er 读 /ɚ/，轻卷舌" },
      { "word": "doctor", "kk": "/ˈdɑktɚ/", "note": "词尾 or 读 /ɚ/" },
      { "word": "mister", "kk": "/ˈmɪstɚ/", "note": "词尾 er 读 /ɚ/" }
    ],
    "mouthTips": [],
    "commonMistakes": []
  },
